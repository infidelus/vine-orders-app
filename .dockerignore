# Files Docker leaves out when building the image.
# Your data stays in the app's folder on the server (see docker-compose.yml),
# so it never needs to be copied into the image itself.
vine_orders.db
vine_orders-download.db
backups/
*.db.tmp
VineOrders.csv
prices.csv

# Not needed to run the app
.git/
.github/
screenshots/
__pycache__/
*.pyc
*.zip
venv/
